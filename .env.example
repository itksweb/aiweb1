# Roof Real Estate - Environment Variables

# OWNER_EMAIL: The email address where visitor inquiries and contact messages will be delivered.
OWNER_EMAIL="jokianny@gmail.com"

# Gmail SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="jokianny@gmail.com"
SMTP_PASSWORD="your-16-character-app-password"

# APP_URL: The public URL where this applet is hosted.
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional Gemini API key for AI Studio environment
GEMINI_API_KEY=""
